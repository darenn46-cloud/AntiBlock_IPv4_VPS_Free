[Unit]
Description=Playit.gg Tunnel Client
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/etc/playit
# Replace with `--secret <YOUR_PLAYIT_SECRET>` if running headless without /etc/playit/playit.toml
ExecStart=/usr/local/bin/playit
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
